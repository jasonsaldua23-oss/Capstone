# Production-only overrides; secrets remain in /etc/aabtrading-backend.env.
DJANGO_DEBUG=0
# Fix: accept the trusted frontend domain forwarded by Next.js rewrites.
DJANGO_ALLOWED_HOSTS=18.138.158.32,.annannsbeveragestrading.com,127.0.0.1
# Trust each production frontend origin for any CSRF-protected requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.annannsbeveragestrading.com,https://warehouse.annannsbeveragestrading.com,https://client.annannsbeveragestrading.com,https://driver.annannsbeveragestrading.com,http://18.138.158.32
DJANGO_TIME_ZONE=Asia/Manila
DB_CONN_MAX_AGE=60
DJANGO_API_ORIGIN=http://18.138.158.32
# Replace Windows-only local CA paths inherited from the development environment.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
