# App database target: only Supabase/Postgres is supported.
APP_DB_TARGET="supa"

# Runtime DB connection for Django backend.
# Use 5432 here to avoid the local timeout issue seen with the 6543 pooler URL.
# Leave `sslmode` unset or use `sslmode=require` for standard Supabase pooler TLS.
# Only use `verify-ca` / `verify-full` when you also provide Supabase's CA cert.
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Direct DB connection for tooling/migrations when needed.
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres"

# Auth
JWT_SECRET="replace-with-long-random-secret"

# Supabase storage for image uploads
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_UPLOADS_BUCKET="uploads"

# Variant: all | admin | driver | customer
NEXT_PUBLIC_APP_VARIANT="admin"

# Optional: mobile webview URL override in capacitor config
CAP_SERVER_URL="https://your-domain.example.com/login/admin"

# Django API origin. All frontend /api/* requests are routed to this backend.
DJANGO_API_ORIGIN="http://127.0.0.1:8000"

# Google OAuth (Google Identity Services for web login buttons)
# Must be a "Web application" OAuth client from Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"

# Gmail OTP settings (required for forgot-password flow)
OTP_FROM_NAME="Ann Ann's Beverages Trading"
OTP_GMAIL_USER="your-gmail-address@gmail.com"
OTP_GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# Gmail API (OAuth 2.0 via Google Cloud Console - recommended for HTTPS email sending)
GMAIL_API_REFRESH_TOKEN="your-gmail-api-oauth2-refresh-token"
GMAIL_API_SENDER_EMAIL="your-gmail-address@gmail.com"

# Optional: Brevo API (recommended for production on Render Free)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
OTP_FROM_EMAIL="verified-sender@yourdomain.com"

