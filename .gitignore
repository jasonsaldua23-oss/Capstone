# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
mobile/driver-app/.expo/
mobile/driver-app/.export-check/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# Secrets and keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
secrets.*
*.secret
.env
.env.*
.env.local
.env.production
.env.development
!.env.example

# Backend secrets
certificates/
backend/.env
backend/.env.*
backend/**/settings_local.py
backend/**/local_settings.py
backend/**/*.sqlite3
backend/**/*.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
dev.log
test
prompt

server.log
dev_stderr.log
replay_pid*.log
*.stderr.log
*.stdout.log
# Skills directory
/skills/

# Python / Django
__pycache__/
*.py[cod]
skills/
dev*.log
dev_stdout.log
# Generated only by the customer-app production bundle verification.
mobile/customer-app/.expo-export-check/
mobile/customer-app/.expo-export-design-check*/
mobile/customer-app/.expo/

# Uploaded media lives in the Supabase Storage bucket, not the repository. Committing
# uploads meant a deploy that resets the working tree restored the committed images
# and deleted every photo uploaded through the portal since the last commit.
backend/media/

# Accidental files created by `> NUL` redirects run under Git Bash, where NUL is a
# real path rather than the Windows null device.
NUL
**/NUL

# Local APK/AAB build output and the unpacked APK used for asset verification.
dist-apk/
**/.expo-apk-check/

# Staging and rollback copies used by the atomic deploy in
# .github/workflows/deploy.yml, plus the local build-verification copy.
/.next.build/
/.next.prev/
# Any other ad-hoc build directory too: an unignored one gets scanned by
# Tailwind's source detection and registered in tsconfig by next build.
/.next*/
