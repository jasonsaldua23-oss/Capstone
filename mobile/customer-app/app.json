{
  "expo": {
    "name": "AAB TRADING SHOP",
    "slug": "logitrack-customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AAB TRADING SHOP to select profile and replacement evidence photos."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "android": {
      "package": "com.logitrack.customer",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.logitrack.customer"
    },
    "extra": {
      "googleClientId": "39666838434-939qeikmkjdk3e4uv95mr8qg6q7hh0c3.apps.googleusercontent.com",
      "eas": {
        "projectId": "ec694036-b410-4a3f-a9d7-30b3a8057dc5"
      }
    }
  }
}
